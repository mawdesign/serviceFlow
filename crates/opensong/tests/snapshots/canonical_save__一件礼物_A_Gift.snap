<?xml version="1.0" encoding="UTF-8"?>
<song>
  <title>一件礼物 (A Gift)</title>
  <author></author>
  <copyright></copyright>
  <hymn_number></hymn_number>
  <presentation></presentation>
  <ccli></ccli>
  <capo print="false" sharp="true"></capo>
